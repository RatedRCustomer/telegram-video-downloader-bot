# Required
BOT_TOKEN=your_telegram_bot_token_here

# Optional
ADMIN_IDS=
MAX_CONCURRENT_DOWNLOADS=2
MAX_FILE_SIZE=2000000000
RATE_LIMIT_PER_MINUTE=5
DOWNLOAD_DIR=/app/data/downloads
DB_PATH=/app/data/bot.db
CLEANUP_INTERVAL_HOURS=1
CACHE_TTL_DAYS=30
AUDIO_BITRATE=192
COOKIES_FILE=/app/data/cookies.txt
COBALT_API_URL=http://cobalt:9000
LOG_LEVEL=INFO

# === Telegram local Bot API ===
# Підняття власного telegram-bot-api сервера дозволяє upload до 2GB (cloud має 50MB).
# api_id + api_hash отримати на https://my.telegram.org/apps
# (це не bot token; це облікові дані для tdlib від вашого Telegram-акаунту).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TG_API_URL=http://tg-api:8081
